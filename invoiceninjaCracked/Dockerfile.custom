ARG PHP=8.3

# Use the official PHP-FPM image
FROM php:${PHP}-fpm

# PHP modules
ARG php_require="bcmath gd mbstring pdo_mysql zip"
ARG php_suggest="exif imagick intl pcntl saxon soap"
ARG php_extra="opcache"

# Install system dependencies and Node.js
RUN apt-get update && apt-get install -y --no-install-recommends \
    mariadb-client \
    gpg \
    supervisor \
    git \
    curl \
    unzip \
    # Unicode support for PDF
    fonts-noto-cjk-extra \
    fonts-wqy-microhei \
    fonts-wqy-zenhei \
    xfonts-wqy \
    # Install google-chrome-stable(amd64)/chromium(arm64) for PDF generation
    && if [ "$(dpkg --print-architecture)" = "amd64" ]; then \
    mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://dl.google.com/linux/linux_signing_key.pub | \
    gpg --dearmor -o /etc/apt/keyrings/google.gpg \
    && echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/google.gpg] https://dl.google.com/linux/chrome/deb/ stable main" > /etc/apt/sources.list.d/google-chrome.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends google-chrome-stable; \
    elif [ "$(dpkg --print-architecture)" = "arm64" ]; then \
    apt-get install -y --no-install-recommends \
    chromium; \        
    fi \
    # Install Node.js 20.x (LTS) using official binary
    && curl -fsSL https://nodejs.org/dist/v20.17.0/node-v20.17.0-linux-x64.tar.xz -o node.tar.xz \
    && tar -xf node.tar.xz -C /usr/local --strip-components=1 \
    && rm node.tar.xz \
    # Verify Node.js and npm installation
    && node --version && npm --version \
    # Create config directory for chromium/google-chrome-stable
    && mkdir /var/www/.config \
    && chown www-data:www-data /var/www/.config \
    # Cleanup
    && apt-get purge -y gpg \
    && apt-get autoremove -y \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install PHP extensions
COPY --from=ghcr.io/mlocati/php-extension-installer /usr/bin/install-php-extensions /usr/local/bin/

RUN install-php-extensions \
    ${php_require} \
    ${php_suggest} \
    ${php_extra}

# Install Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Copy the modified Invoice Ninja source code (with paywall bypass)
COPY invoiceninja/ /var/www/html/

# Set working directory
WORKDIR /var/www/html

# Verify essential files exist
RUN ls -la && \
    test -f composer.json || (echo "ERROR: composer.json not found!" && exit 1)

# Ensure storage directories exist and have correct permissions
# Create them if they don't exist (in case .gitignore excluded them)
RUN mkdir -p storage/app/public storage/framework/{cache,sessions,testing,views} storage/logs bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache

# Install dependencies (without dev dependencies for production)
# Move preload.php temporarily to avoid autoload error
# Run composer with proper environment to avoid cache issues
ENV COMPOSER_ALLOW_SUPERUSER=1
RUN if [ -f preload.php ]; then mv preload.php preload.php.bak; fi && \
    composer install --no-dev --optimize-autoloader --no-interaction --no-scripts && \
    if [ -f preload.php.bak ]; then mv preload.php.bak preload.php; fi && \
    composer dump-autoload --optimize --no-scripts

# Build Vite assets for the client portal
RUN npm install && \
    npm run build && \
    # Ensure build directory exists
    test -d public/build || (echo "ERROR: Vite build failed!" && exit 1)

# Build React UI with correct API URL
ARG VITE_API_URL
ARG VITE_IS_HOSTED=false

# Copy UI repository and build with environment-specific configuration
COPY invoiceninjaUi/ui /tmp/ui
# Build React UI with environment-specific configuration
RUN if [ -n "$VITE_API_URL" ]; then \
        echo "🚀 Building React UI with API URL: $VITE_API_URL" && \
        cd /tmp/ui && \
        cp .env.example .env && \
        sed -i 's/VITE_IS_TEST=true/VITE_IS_TEST=false/' .env && \
        echo "VITE_API_URL=$VITE_API_URL" >> .env && \
        echo "VITE_IS_HOSTED=$VITE_IS_HOSTED" >> .env && \
        echo "VITE_PUSHER_APP_KEY=f0111a02782708da651f" >> .env && \
        cp /var/www/html/vite.config.ts.react ./vite.config.js && \
        npm install && \
        npm run build && \
        rm -rf /var/www/html/public/react-app/react && \
        mkdir -p /var/www/html/public/react-app/react && \
        cp -r dist/* /var/www/html/public/react-app/react/ && \
        rm -rf /tmp/ui; \
    else \
        echo "⚠️  VITE_API_URL not provided, using pre-built React assets (may have localhost issues)"; \
    fi

# Create React template and update file references
RUN if [ -n "$VITE_API_URL" ]; then \
        BUNDLE_FILE=$(ls /var/www/html/public/react-app/react/bundle.*.js 2>/dev/null | head -n1 | xargs basename 2>/dev/null || echo "bundle.js") && \
        CSS_FILE=$(ls /var/www/html/public/react-app/react/index-*.css 2>/dev/null | head -n1 | xargs basename 2>/dev/null || echo "index.css") && \
        echo '<!DOCTYPE html>' > /var/www/html/resources/views/react/index.blade.php && \
        echo '<html data-report-errors="{{ $report_errors }}" data-rc="{{ $rc }}" data-user-agent="{{ $user_agent }}" data-login="{{ $login }}" lang="en" class="h-full">' >> /var/www/html/resources/views/react/index.blade.php && \
        echo '  <head>' >> /var/www/html/resources/views/react/index.blade.php && \
        echo '    <title>{{ config('\''ninja.app_name'\'') }}</title>' >> /var/www/html/resources/views/react/index.blade.php && \
        echo '    <meta charset="utf-8" />' >> /var/www/html/resources/views/react/index.blade.php && \
        echo '    <meta name="viewport" content="width=device-width, initial-scale=1" />' >> /var/www/html/resources/views/react/index.blade.php && \
        echo '    <meta name="theme-color" content="#000000" />' >> /var/www/html/resources/views/react/index.blade.php && \
        echo '    <meta name="description" content="Leading free invoice generator for freelancers and small businesses." />' >> /var/www/html/resources/views/react/index.blade.php && \
        echo '    <link rel="stylesheet" href="/react-app/react/rsms/inter.css" />' >> /var/www/html/resources/views/react/index.blade.php && \
        echo '    <link rel="icon" href="/react-app/react/favicon.ico" />' >> /var/www/html/resources/views/react/index.blade.php && \
        echo '    <link rel="apple-touch-icon" href="/react-app/react/logo180.png" />' >> /var/www/html/resources/views/react/index.blade.php && \
        echo '    <link rel="manifest" href="/react-app/react/manifest.json" />' >> /var/www/html/resources/views/react/index.blade.php && \
        echo '    @include('\''react.head'\'')' >> /var/www/html/resources/views/react/index.blade.php && \
        echo '    <script type="module" crossorigin src="/react-app/react/BUNDLE_FILE_PLACEHOLDER"></script>' >> /var/www/html/resources/views/react/index.blade.php && \
        echo '    <link rel="stylesheet" crossorigin href="/react-app/react/CSS_FILE_PLACEHOLDER">' >> /var/www/html/resources/views/react/index.blade.php && \
        echo '  </head>' >> /var/www/html/resources/views/react/index.blade.php && \
        echo '  <body class="h-full">' >> /var/www/html/resources/views/react/index.blade.php && \
        echo '    <noscript>You need to enable JavaScript to run this app.</noscript>' >> /var/www/html/resources/views/react/index.blade.php && \
        echo '    <div id="root"></div>' >> /var/www/html/resources/views/react/index.blade.php && \
        echo '    <script>' >> /var/www/html/resources/views/react/index.blade.php && \
        echo '      window.__VITE_API_URL__ = '\''{{ config('\''app.url'\'') }}'\'';' >> /var/www/html/resources/views/react/index.blade.php && \
        echo '      window.__VITE_IS_HOSTED__ = '\''false'\'';' >> /var/www/html/resources/views/react/index.blade.php && \
        echo '      window.__API_URL__ = '\''{{ config('\''app.url'\'') }}'\'';' >> /var/www/html/resources/views/react/index.blade.php && \
        echo '    </script>' >> /var/www/html/resources/views/react/index.blade.php && \
        echo '  </body>' >> /var/www/html/resources/views/react/index.blade.php && \
        echo '</html>' >> /var/www/html/resources/views/react/index.blade.php && \
        sed -i "s/BUNDLE_FILE_PLACEHOLDER/$BUNDLE_FILE/g" /var/www/html/resources/views/react/index.blade.php && \
        sed -i "s/CSS_FILE_PLACEHOLDER/$CSS_FILE/g" /var/www/html/resources/views/react/index.blade.php && \
        echo "✅ React UI built and deployed successfully with $BUNDLE_FILE and $CSS_FILE"; \
    fi

# Configure PHP
RUN ln -s "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"

# Copy PHP configuration
COPY dockerfiles/debian/php/php.ini /usr/local/etc/php/conf.d/invoiceninja.ini
COPY dockerfiles/debian/php/php-fpm.conf /usr/local/etc/php-fpm.d/invoiceninja.conf

# Setup supervisor
COPY dockerfiles/debian/supervisor/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Set final permissions and create remaining directories
RUN mkdir -p storage/app/public \
    && mkdir -p storage/framework/sessions \
    && mkdir -p storage/framework/views \
    && mkdir -p storage/framework/cache \
    && mkdir -p storage/framework/testing \
    && mkdir -p storage/logs \
    && chown -R www-data:www-data /var/www/html \
    && find /var/www/html -type f -exec chmod 644 {} \; \
    && find /var/www/html -type d -exec chmod 755 {} \; \
    && chmod -R 775 storage bootstrap/cache

# Skip Laravel post-install scripts during build - they will run at container startup
# when the actual .env file is mounted
# RUN php artisan package:discover --ansi
# RUN php artisan storage:link

# Copy initialization script
COPY dockerfiles/debian/scripts/init-custom.sh /usr/local/bin/init.sh
RUN chmod +x /usr/local/bin/init.sh

# Verify paywall bypass is in place
RUN grep -q "return true; // Bypass white label check" /var/www/html/app/Models/Account.php && \
    echo "✓ Paywall bypass verified" || \
    (echo "✗ Paywall bypass NOT found!" && exit 1)

# Set environment variables for PDF generation
ENV SNAPPDF_CHROMIUM_PATH=/usr/bin/google-chrome-stable

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD pgrep -f "php-fpm: master process"

# Expose PHP-FPM port for Nginx Proxy Manager
EXPOSE 9000

ENTRYPOINT ["/usr/local/bin/init.sh"]
CMD ["supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]