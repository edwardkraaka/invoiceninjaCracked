# ===================================
# Invoice Ninja Configuration
# ===================================
# Copy this file to .env and update the values below

# ===================================
# Application URL
# ===================================
# IMPORTANT: Set this to your actual domain or IP address
# Examples:
#   - http://localhost (for local development)
#   - https://invoicing.yourdomain.com (for production)
APP_URL=http://localhost

# ===================================
# Database Configuration
# ===================================
DB_HOST=invoiceninja-mariadb
DB_DATABASE=invoiceninja
DB_USERNAME=ninja
DB_PASSWORD=change_this_password_to_something_secure
DB_ROOT_PASSWORD=change_this_root_password_to_something_secure

# ===================================
# Admin Account (Created on First Run)
# ===================================
IN_USER_EMAIL=admin@example.com
IN_PASSWORD=change_this_password

# ===================================
# Application Key
# ===================================
# Generate a secure key with: openssl rand -base64 32
# Then add it here with the base64: prefix
APP_KEY=

# ===================================
# Application Environment
# ===================================
APP_ENV=production
APP_DEBUG=false
REQUIRE_HTTPS=false

# ===================================
# Redis Configuration
# ===================================
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ===================================
# Mail Configuration (Optional)
# ===================================
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# ===================================
# Queue Configuration
# ===================================
QUEUE_CONNECTION=database

# ===================================
# Session Configuration
# ===================================
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ===================================
# Cache Configuration
# ===================================
CACHE_DRIVER=file

# ===================================
# Logging
# ===================================
LOG_CHANNEL=stack
LOG_LEVEL=debug

# ===================================
# PDF Generation
# ===================================
PDF_GENERATOR=snappdf

# ===================================
# Broadcasting (Optional)
# ===================================
BROADCAST_DRIVER=log

# ===================================
# Trusted Proxies (for reverse proxy setups)
# ===================================
TRUSTED_PROXIES=*

