# Invoice Ninja Docker Environment Configuration
# Based on your preferred working configuration with MariaDB

# Application Settings
APP_NAME="Invoice Ninja"
APP_ENV=production
APP_KEY=base64:JsurbG3sctHvwzwCMZX3cuxYfM3tQrcIWB/E0fAcnGQ=
APP_DEBUG=false
APP_URL=https://routespring.shop
REACT_URL=https://routespring.shop

# Self-hosted mode (enables most features)
NINJA_ENVIRONMENT=selfhost

# PDF Generation
PHANTOMJS_PDF_GENERATION=false
PDF_GENERATOR=snappdf
SNAPPDF_CHROMIUM_PATH=/usr/bin/chromium
TRUSTED_PROXIES='*'

# Security
REQUIRE_HTTPS=true

# Database Configuration (MariaDB)
DB_HOST=invoiceninja-mariadb
DB_PORT=3306
DB_DATABASE=invoiceninja
DB_USERNAME=invoiceninja
DB_PASSWORD=GotDiscardConsonantChauffeur
MYSQL_ROOT_PASSWORD=RemunerationPendantBroomIntrusion

# Initial Admin User
IN_USER_EMAIL=support@althams.org
IN_PASSWORD=CantHaCk101

# Email Configuration
MAIL_MAILER=smtp
MAIL_HOST=SMTP_SERVER_HERE
MAIL_PORT=587
MAIL_USERNAME=PUT_YOUR_EMAIL_HERE
MAIL_PASSWORD=PUT_YOUR_APP_PASSWORD_HERE
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=PUT_YOUR_EMAIL_HERE
MAIL_FROM_NAME='Invoice Ninja'

# Redis Configuration
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Performance Settings
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
BROADCAST_DRIVER=log
LOG_CHANNEL=stack

# Docker Environment
IS_DOCKER=true
SCOUT_DRIVER=null
FILESYSTEM_DISK=local

# Features - All enabled due to paywall bypass
ENABLE_SHOP_API=true
MULTI_DB_ENABLED=false

# Timezone and Locale
TZ=Africa/Harare
DEFAULT_TIMEZONE=56
DEFAULT_LOCALE=en

# Optional: Banking Integration
NORDIGEN_SECRET_ID=
NORDIGEN_SECRET_KEY=

# Optional: Error Tracking
SENTRY_LARAVEL_DSN=

# Optional: Analytics
GOOGLE_ANALYTICS_ID=
MATOMO_URL=
MATOMO_SITE_ID=

# Optional: Maps
GOOGLE_MAPS_API_KEY=

# Optional: Captcha
CAPTCHA_KEY=
CAPTCHA_SECRET=

# Optional: PhantomJS Cloud (alternative PDF generator)
PHANTOMJS_CLOUD_KEY=

# Optional: Mailgun
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net

# Optional: Postmark
POSTMARK_SECRET=

# Optional: Microsoft OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Optional: Apple OAuth
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Optional: AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=